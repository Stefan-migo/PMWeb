{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "DESIGN.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "_note": "Free docs search for any library."
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "_note": "Structured reasoning for complex problems."
    },
    "storybook": {
      "type": "remote",
      "url": "http://localhost:6006/mcp",
      "enabled": true,
      "_note": "Storybook MCP addon — UI component info and dev workflows. Requires `npm run storybook` running on port 6006."
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "_note": "GitHub PR and issue management. Set GITHUB_TOKEN first."
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
